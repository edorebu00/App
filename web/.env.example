# Progetto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave API Anthropic (console.anthropic.com), usata solo lato server dalle API route
# in app/api/agent/* per la ricerca web e la chat sui documenti.
ANTHROPIC_API_KEY=

# Modello Claude da usare per ricerca e chat
CLAUDE_MODEL=claude-sonnet-5

# Opzionale: chiave OpenAI (platform.openai.com) usata SOLO come fallback se Anthropic
# non risponde (timeout/errore/rate limit), cosi' l'utente non vede mai un errore. Se
# lasciata vuota il fallback viene semplicemente saltato. Attenzione: quando scatta,
# la richiesta viene fatturata da OpenAI e non da Anthropic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_SEARCH_MODEL=gpt-4o
