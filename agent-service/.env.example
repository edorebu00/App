# Chiave API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modello Claude da usare per ricerca e chat
CLAUDE_MODEL=claude-sonnet-5

# Progetto Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origine consentita per le richieste CORS (URL del frontend su Vercel)
WEB_APP_ORIGIN=http://localhost:3000

# Porta del servizio (Railway la imposta automaticamente in produzione)
PORT=8080
